+func appendUniqueStrings(base []string, values ...string) []string {
+	seen := map[string]bool{}
+	for _, value := range base {
+		seen[value] = true
+	}
+	for _, value := range values {
+		if value == "" || seen[value] {
+			continue
+		}
+		seen[value] = true
+		base = append(base, value)
+	}
+	return base
+}
