+func hamiVGPUHostSourcesFromRestoreLog(data string) []string {
+	seen := map[string]bool{}
+	var out []string
+	for _, prefix := range []string{
+		"/usr/local/vgpu/containers/",
+		"/usr/local/vgpu/restore-cache/",
+	} {
+		start := 0
+		for {
+			idx := strings.Index(data[start:], prefix)
+			if idx < 0 {
+				break
+			}
+			idx += start
+			end := idx
+			for end < len(data) {
+				switch data[end] {
+				case ' ', '\n', '\t', ':', '\'', '"', '`':
+					goto found
+				}
+				end++
+			}
+		found:
+			src := strings.TrimRight(data[idx:end], ".;,")
+			start = end
+			if src == "" || strings.Contains(src, "..") || seen[src] {
+				continue
+			}
+			seen[src] = true
+			out = append(out, src)
+		}
+	}
+	return out
+}
