+
+func writeGPURestoreCRIUConfig(mounts []*types.Mount, name string) (string, error) {
+	if strings.TrimSpace(name) == "" {
+		name = "restore"
+	}
+	name = strings.NewReplacer("/", "_", "\\", "_", ":", "_").Replace(name)
+
+	dir := "/var/lib/gpu-cr/restore"
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", fmt.Errorf("create gpu-cr restore config dir: %w", err)
+	}
+
+	path := filepath.Join(dir, name+"-criu-restore.conf")
+	lines := []string{
+		"tcp-close",
+		"ext-unix-sk",
+	}
+	seen := map[string]bool{}
+	for _, m := range mounts {
+		if m == nil || m.HostPath == "" || m.ContainerPath == "" {
+			continue
+		}
+		if !filepath.IsAbs(m.HostPath) || !filepath.IsAbs(m.ContainerPath) {
+			continue
+		}
+		entry := fmt.Sprintf("external mnt[%s]:%s", m.HostPath, m.ContainerPath)
+		if seen[entry] {
+			continue
+		}
+		seen[entry] = true
+		lines = append(lines, entry)
+	}
+	if err := os.WriteFile(path, []byte(strings.Join(lines, "\n")+"\n"), 0o644); err != nil {
+		return "", fmt.Errorf("write gpu-cr restore CRIU config: %w", err)
+	}
+	return path, nil
+}
